# Variables substituted from CMakeLists.txt
set(SRCDIR "@CMAKE_CURRENT_SOURCE_DIR@")
set(BINDIR "@CMAKE_CURRENT_BINARY_DIR@")

set(AWK "@AWK@")
set(DFA_XTRA "@DFA_XTRA@")
set(CI_PREFIX "@CI_PREFIX@")
set(CILIB_VERSION "@CILIB_VERSION@")

if(OUTPUT MATCHES "(scripts/cilibconf\\.c)\$")
  # Generate "${BINDIR}/scripts/cilibconf.c"

  file(REMOVE "${BINDIR}/cilibconf.tf6" "${BINDIR}/cilibconf.tf7")

  execute_process(COMMAND "${CMAKE_COMMAND}" -E echo "com ${CILIB_VERSION} STANDARD API DEFINITION"
                  COMMAND "${AWK}" -f "${SRCDIR}/scripts/options.awk"
                          "out=cilibconf.tf6" "logunsupported=1" "version=search"
                          "${SRCDIR}/ciconf.h" "-"
                          "${SRCDIR}/scripts/cilibconf.dfa"
                  WORKING_DIRECTORY "${BINDIR}"
                  RESULT_VARIABLE AWK_FAIL)
  if(AWK_FAIL)
    message(FATAL_ERROR "Failed to generate cilibconf.tf6")
  endif()

  execute_process(COMMAND "${AWK}" -f "${SRCDIR}/scripts/options.awk"
                  "out=cilibconf.tf7" "cilibconf.tf6"
                  WORKING_DIRECTORY "${BINDIR}"
                  RESULT_VARIABLE AWK_FAIL)
  if(AWK_FAIL)
    message(FATAL_ERROR "Failed to generate cilibconf.tf7")
  endif()

  file(REMOVE "cilibconf.tf6")
  file(MAKE_DIRECTORY "${BINDIR}/scripts")
  file(RENAME "cilibconf.tf7" "${BINDIR}/scripts/cilibconf.c")

elseif(OUTPUT MATCHES "(cilibconf\\.c)\$")
  # Generate "${BINDIR}/cilibconf.c"

  file(REMOVE "${BINDIR}/cilibconf.tf4" "${BINDIR}/cilibconf.tf5")

  execute_process(COMMAND "${AWK}" -f "${SRCDIR}/scripts/options.awk"
                  out=cilibconf.tf4 version=search
                  ${SRCDIR}/ciconf.h ${SRCDIR}/scripts/cilibconf.dfa
                  ${SRCDIR}/ciusr.dfa ${DFA_XTRA}
                  WORKING_DIRECTORY "${BINDIR}"
                  RESULT_VARIABLE AWK_FAIL)
  if(AWK_FAIL)
    message(FATAL_ERROR "Failed to generate cilibconf.tf4")
  endif()

  execute_process(COMMAND "${AWK}" -f "${SRCDIR}/scripts/options.awk"
                  out=cilibconf.tf5 cilibconf.tf4
                  WORKING_DIRECTORY "${BINDIR}"
                  RESULT_VARIABLE AWK_FAIL)
  if(AWK_FAIL)
    message(FATAL_ERROR "Failed to generate cilibconf.tf5")
  endif()

  file(REMOVE "cilibconf.tf4")
  file(MAKE_DIRECTORY "${BINDIR}/scripts")
  file(RENAME "cilibconf.tf5" "${BINDIR}/cilibconf.c")

elseif(OUTPUT MATCHES "(cilibconf\\.h)\$")
  # Generate "${BINDIR}/cilibconf.h"

  file(REMOVE "${OUTPUT}")
  if(CI_PREFIX)
    file(REMOVE "cilibconf.tf8")

    execute_process(COMMAND "${AWK}" "s==0 && NR>1{print prev}
                             s==0{prev=\$0}
                             s==1{print \"#define\", \$1, \"${CI_PREFIX}\" \$1}
                             s==2{print \"#define ${CI_PREFIX}ci_\" \$1, \"CI_\" \$1}
                             END{print prev}" s=0 cilibconf.out s=1 "${BINDIR}/scripts/prefix.out"
                             s=2 "${SRCDIR}/scripts/macro.lst"
                    OUTPUT_FILE cilibconf.tf8
                    RESULT_VARIABLE AWK_FAIL)
    if(AWK_FAIL)
      message(FATAL_ERROR "Failed to generate cilibconf.tf8")
    endif()

    file(RENAME "cilibconf.tf8" "${OUTPUT}")
  else()
    execute_process(COMMAND "${CMAKE_COMMAND}" -E copy "cilibconf.out"
                                                       "${OUTPUT}"
                    WORKING_DIRECTORY "${BINDIR}"
                    RESULT_VARIABLE COPY_FAIL)
    if(COPY_FAIL)
      message(FATAL_ERROR "Failed to create cilibconf.h")
    endif()
  endif()

elseif(OUTPUT MATCHES "(ciprefix\\.h)\$")
  # Generate "${BINDIR}/ciprefix.h"

  file(REMOVE "${OUTPUT}")

  if(CI_PREFIX)
    file(REMOVE "ciprefix.tf1")

    execute_process(COMMAND "${AWK}"
                            "{print \"#define\", \$1, \"${CI_PREFIX}\" \$1}"
                            "${BINDIR}/scripts/intprefix.out"
                    OUTPUT_FILE "ciprefix.tf1"
                    RESULT_VARIABLE AWK_FAIL)
    if(AWK_FAIL)
      message(FATAL_ERROR "Failed to generate ciprefix.tf1")
    endif()

    file(RENAME "ciprefix.tf1" "${OUTPUT}")
  else()
    file(WRITE "${OUTPUT}" "/* No libci symbol prefix configured. */")
  endif()

elseif(OUTPUT MATCHES "(scripts/cilibconf\\.h\\.prebuilt)\$")
  # Generate scripts/cilibconf.h.prebuilt (fails build)

  message(STATUS "Attempting to build scripts/cilibconf.h.prebuilt")
  message(STATUS "This is a machine generated file, but if you want to make")
  message(STATUS "a new one simply build the 'ci_genfiles' target, and copy")
  message(STATUS "scripts/cilibconf.out to scripts/cilibconf.h.prebuilt")
  message(STATUS "AND set CI_ZLIB_VERNUM to 0 (you MUST do this)")
  message(FATAL_ERROR "Stopping build")

else()

  message(FATAL_ERROR "Unsupported output: ${OUTPUT}")

endif()
