# For conditions of distribution and use, see the disclaimer
# and license in ci.h

CC       = scppc
CFLAGS   = NOSTKCHK NOSINT OPTIMIZE OPTGO OPTPEEP OPTINLOCAL OPTINL IDIR /zlib \
           OPTLOOP OPTRDEP=8 OPTDEP=8 OPTCOMP=8
LIBNAME  = libci.a
AR       = ppc-amigaos-ar
ARFLAGS  = cr
RANLIB   = ppc-amigaos-ranlib
LDFLAGS  = -r -o
LDLIBS   =  ../zlib/libzip.a LIB:scppc.a
LN       = ppc-amigaos-ld
RM       = delete quiet

OBJS = ci.o cierror.o ciget.o cimem.o cipread.o \
       ciread.o cirio.o cirtran.o cirutil.o ciset.o \
       citrans.o ciwio.o ciwrite.o ciwtran.o ciwutil.o

all: $(LIBNAME) citest

$(LIBNAME): $(OBJS)
            $(AR) $(ARFLAGS) $@ $(OBJS)
            $(RANLIB) $@

citest: citest.o $(LIBNAME)
        $(LN) $(LDFLAGS) citest LIB:c_ppc.o citest.o $(LIBNAME) $(LDLIBS) \
LIB:end.o
