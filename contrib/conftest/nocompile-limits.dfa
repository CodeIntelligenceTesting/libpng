#
# Build libci without any limits and without run-time settable limits.  Turning
# USER_LIMITS off reduces libci code size by allowing compile-time elimination
# of some checking code.
#
option USER_LIMITS off

@# define CI_USER_WIDTH_MAX CI_UINT_31_MAX
@# define CI_USER_HEIGHT_MAX CI_UINT_31_MAX
@# define CI_USER_CHUNK_CACHE_MAX 0
@# define CI_USER_CHUNK_MALLOC_MAX 0
